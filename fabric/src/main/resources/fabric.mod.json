{
  "schemaVersion": 1,
  "id": "aris",
  "version": "${version}",
  "name": "Aris",
  "description": "A realistic world generation mod for Minecraft.",
  "authors": [
    "Tenakt"
  ],
  "environment": "*",

  "entrypoints": {
    "main": [
      "com.grindlesstudio.aris.ArisFabric"
    ],
    "client": [
      "com.grindlesstudio.aris.client.ArisClient"
    ],
    "fabric-datagen": [
      "com.grindlesstudio.aris.client.ArisDataGenerator"
    ]
  },

  "mixins": [
    "aris.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}